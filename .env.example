# Cluster connection
KUBECONFIG=~/.kube/config
ACM_HUB_CONTEXT=<your-kube-context>

# Cloud provider
ACM_PLATFORM=ibmcloud
IBMCLOUD_API_KEY=<your-ibmcloud-api-key>
IBMCLOUD_REGION=<region>

# AWS (when ACM_PLATFORM=aws)
AWS_ACCESS_KEY_ID=<your-aws-access-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-key>
AWS_REGION=<aws-region>
ACM_AWS_BASE_DOMAIN=<your-route53-zone>

# Cluster defaults
ACM_BASE_DOMAIN=<your-base-domain>
ACM_CLUSTER_IMAGE_SET=<img-version-multi-appsub>
ACM_DEFAULT_WORKER_TYPE=<worker-instance-type>
ACM_DEFAULT_MASTER_TYPE=<master-instance-type>
ACM_DEFAULT_WORKER_REPLICAS=2
ACM_DEFAULT_MASTER_REPLICAS=3

# Cluster name mapping (override to match your hub's ManagedClusters)
ACM_CLUSTER_SPOKE1=<primary-spoke-cluster>
ACM_CLUSTER_SPOKE2=<secondary-spoke-cluster>
ACM_CLUSTER_HUB=<hub-cluster-name>

# Timeouts
ACM_PROVISION_TIMEOUT=45m
ACM_OPERATION_TIMEOUT=5m

# MCP
ACM_MCP_LOG_LEVEL=info
